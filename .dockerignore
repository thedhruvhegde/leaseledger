# Keep the build context and image lean: only what the API, the pipeline build and the web build need.
.git
.github
.agents
.claude
.pytest_cache
**/__pycache__
**/*.pyc
.env
**/.env
**/.env.local

# Built inside the image (fresh from the committed feeds), never copied in
data/artifacts
data/cache/*
!data/cache/llm
web/dist
**/node_modules

# Not used at runtime
data/multicity
presentation/node_modules
presentation/dist
presentation/dist-artifact
presentation/screenshots
presentation/export
execution
analysis/multicity/results/*.npz
web/screenshots
web/design
research
concepts
decisions
architecture
tests
