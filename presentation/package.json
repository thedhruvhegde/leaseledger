{
  "name": "lease-ledger-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prep": "node scripts/prep-basemap.mjs && node scripts/prep-interviews.mjs",
    "dev": "npm run prep && vite --port 4400 --strictPort",
    "check": "node scripts/check-copy.mjs",
    "build": "npm run prep && node scripts/check-copy.mjs --strict && tsc --noEmit && vite build",
    "build:draft": "npm run prep && node scripts/check-copy.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4400 --strictPort",
    "snapshot": "node scripts/snapshot.mjs",
    "screenshots": "node scripts/screenshots.cjs",
    "export": "node scripts/export-pdf.cjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.2.8",
    "@fontsource-variable/inter-tight": "5.2.7",
    "katex": "0.16.11"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "22.10.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
